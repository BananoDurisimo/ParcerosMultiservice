PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/parceros_multiservice
# Para PostgreSQL local: false. Para Render/Supabase externo: true.
DB_SSL=false
# Obligatorio y propio: minimo 32 caracteres (el servidor no arranca sin el).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
FRONTEND_URL=http://localhost:5173
# Solo para `npm test`: base LOCAL de pruebas (migrada y con la semilla) donde
# corren las pruebas de reglas de negocio. Sin ella esas pruebas se omiten.
# TEST_DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/parceros_test
