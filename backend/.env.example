PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/parceros_multiservice
# Para PostgreSQL local: false. Para Render/Supabase externo: true.
DB_SSL=false
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
FRONTEND_URL=http://localhost:5173
# Correos (recuperar contraseña y aviso de estado del pedido) con la API de Brevo.
# Sin BREVO_API_KEY no se envia ningun correo. El remitente debe estar verificado en Brevo.
BREVO_API_KEY=
CORREO_REMITENTE=
# Direccion del frontend para el enlace del correo (en produccion, la de GitHub Pages).
APP_URL=http://localhost:5173
